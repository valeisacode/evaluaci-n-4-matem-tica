import random
import numpy as np
import matplotlib.pyplot as plt

def pedir_numeros():
    while True:
        entrada = input("Ingrese entre 1 y 30 números (1-105) separados por espacios: ")
        try:
            numeros = list(map(int, entrada.strip().split()))
            if 1 <= len(numeros) <= 30 and all(1 <= n <= 105 for n in numeros):
                return numeros
            else:
                print("Debe ingresar entre 1 y 30 números, todos entre 1 y 100.")
        except ValueError:
            print("Entrada inválida. Ingrese solo números enteros separados por espacios.")

def generar_tabla_sudoku(numeros):
    
    tabla = np.zeros((9,9), dtype=int)
    
    for i in range(9):
        for j in range(9):
            tabla[i][j] = random.choice(numeros)
    return tabla

def mostrar_tabla(tabla):
    print("Tabla generada (formato Sudoku 9x9):")
    for i, fila in enumerate(tabla):
        fila_str = " ".join(f"{num:3d}" for num in fila)
        print(fila_str)
        if (i+1) % 3 == 0 and i != 8:
            print("-" * 29)

def mostrar_imagen(tabla):
    fig, ax = plt.subplots(figsize=(6,6))
    ax.matshow(np.ones((9,9)), cmap="Pastel1")  
    for (i, j), val in np.ndenumerate(tabla):
        ax.text(j, i, str(val), va='center', ha='center', fontsize=14)
    
    for k in range(10):
        lw = 2 if k % 3 == 0 else 1
        ax.axhline(k-0.5, color='black', linewidth=lw)
        ax.axvline(k-0.5, color='black', linewidth=lw)
    ax.axis('off')
    plt.title("Rotativa")
    plt.show()

def main():
    numeros = pedir_numeros()
    tabla = generar_tabla_sudoku(numeros)
    mostrar_tabla(tabla)

    ver_imagen = input("¿Desea ver una imagen del resultado? (s/n): ").strip().lower()
    if ver_imagen == 's':
        mostrar_imagen(tabla)
    else:
        print("Programa finalizado.")

if __name__ == "__main__":
    main()

